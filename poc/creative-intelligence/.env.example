# Creative Intelligence PoC — environment configuration
# The app runs fully on fixture data with NO keys set.
# Real providers activate automatically when their keys are present (later iterations).

# SQLite database file (default: ./var/poc.db)
# CI_DB_PATH=./var/poc.db

# --- Deep AI Analysis ---
# With a key set, the Claude engine (claude-opus-4-8) generates real analyses;
# without one, a clearly-labeled heuristic fixture engine serves demo output.
# ANTHROPIC_API_KEY=
# CI_ANALYSIS_MODEL=claude-opus-4-8

# --- Discovery (Trend Radar) ---
# With YOUTUBE_API_KEY set, real YouTube Data API v3 results replace the fixture
# demo feed automatically. Get a free key: Google Cloud Console → enable
# "YouTube Data API v3" → Credentials → API key.
# YOUTUBE_API_KEY=
# CI_YOUTUBE_MAX_KEYWORDS=6   # quota guard: searches per harvest (search.list is quota-heavy)
#
# Force a specific provider regardless of which keys are present:
#   CI_DISCOVERY_PROVIDER=fixture   → always demo data (used to pin the test suite)
#   CI_DISCOVERY_PROVIDER=youtube   → force YouTube (errors if no key)
# CI_DISCOVERY_PROVIDER=
#
# Next iteration (TikTok):
# SCRAPECREATORS_API_KEY=
