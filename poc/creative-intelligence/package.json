{
  "name": "creative-intelligence-poc",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone PoC: AI-assisted content research workflow (Research Hub → Trend Radar → Opportunity Detail → AI Analysis → Brief → Meeting Mode)",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts --ext .ts,.tsx,.mjs",
    "seed": "tsx scripts/seed.ts",
    "validate": "npm run typecheck && npm run lint && npm run build",
    "validate:runtime": "node scripts/validate-runtime.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "next": "^15.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.25.0",
    "eslint-config-next": "^15.3.0",
    "playwright-core": "^1.52.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
